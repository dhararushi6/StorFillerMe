// Storefiller — Prisma schema. Source of truth: storefiller-architecture.md §2.1.
// Extensions (pg_trgm, postgis) are Prisma-managed so CREATE EXTENSION is emitted
// in-order before any geography column. GIN/GIST indexes + append-only grants are
// raw-SQL supplements (§2.2) applied via hand-edited migration files.

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ═══════════════════════════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════════════════════════

enum Role {
  BUYER
  AGENT
  ADMIN
}

enum ProductUnit {
  KG
  GRAM
  LITRE
  ML
  PACK
  PIECE
  BOX
}

// ═══════════════════════════════════════════════════════════════════════════
// Part 1 — Auth & Shop (B1-04)
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id                String   @id @default(uuid())
  phone             String   @unique
  email             String?  @unique
  role              Role
  firebaseUid       String?  @unique
  isActive          Boolean  @default(true)
  pushEnabled       Boolean  @default(true)
  orderUpdatesOptIn Boolean  @default(true)
  promoOptIn        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shopProfile   ShopProfile?
  agentProfile  AgentProfile?
  deviceTokens  DeviceToken[]
  refreshTokens RefreshToken[]
  // Relations to Part 2/3/4 models are added in their respective schema tasks
  // (B2-01, B3-01, B3-02): cartItems, orders, wallet, ratings, tickets,
  // referralCode, referralsMade, referralsRecv, auditLogs.

  @@index([phone])
}

// Refresh-token rotation with family reuse-detection (B1-05). Opaque tokens are
// stored only as sha256 hashes; presenting an already-rotated token outside the
// grace window revokes the whole familyId. (Extends the base 22-model schema.)
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  familyId    String
  hashedToken String    @unique
  usedAt      DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model ShopProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
  shopName     String
  ownerName    String
  shopPhotoUrl String?
  addressLine  String
  city         String
  state        String
  pincode      String
  latitude     Float
  longitude    Float
  // Kept in sync with latitude/longitude on every write from the app layer.
  // GIST index added via raw SQL supplement in B3-02.
  location     Unsupported("geography(Point,4326)")?
  createdAt    DateTime                              @default(now())
  updatedAt    DateTime                              @updatedAt
}

model AgentProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  vehicleType   String?
  isAvailable   Boolean  @default(true)
  lastLatitude  Float?
  lastLongitude Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Email-OTP fallback storage (B1-06). OTPs are stored only as bcrypt hashes and
// pruned hourly by cron. (Extends the base 22-model schema — no OTP table exists there.)
model EmailOtp {
  id         String    @id @default(uuid())
  email      String
  otpHash    String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Part 2 — Catalog (B2-01). GIN trigram indexes on Product(name,brand) are added
// via the raw-SQL supplement migration (§2.2).
// ═══════════════════════════════════════════════════════════════════════════

model Category {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  iconUrl       String?
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryTree")
  displayOrder  Int        @default(0)
  isActive      Boolean    @default(true)
  products      Product[]
}

model Product {
  id           String            @id @default(uuid())
  name         String
  brand        String?
  sku          String            @unique
  categoryId   String
  category     Category          @relation(fields: [categoryId], references: [id])
  unit         ProductUnit
  unitSize     String
  caseQty      Int               @default(1)
  mrp          Decimal           @db.Decimal(10, 2)
  sellingPrice Decimal           @db.Decimal(10, 2)
  imageUrl     String?
  description  String?
  isActive     Boolean           @default(true)
  version      Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  inventory    ProductInventory?
  // cartItems / orderItems relations added in B2-05 (cart) and B3-01 (orders).

  @@index([categoryId])
}

model ProductInventory {
  productId         String   @id
  product           Product  @relation(fields: [productId], references: [id])
  quantityAvailable Int      @default(0)
  quantityReserved  Int      @default(0)
  lowStockThreshold Int      @default(10)
  updatedAt         DateTime @updatedAt
}
