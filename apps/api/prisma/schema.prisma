// Storefiller — Prisma schema. Source of truth: storefiller-architecture.md §2.1.
// Extensions (pg_trgm, postgis) are Prisma-managed so CREATE EXTENSION is emitted
// in-order before any geography column. GIN/GIST indexes + append-only grants are
// raw-SQL supplements (§2.2) applied via hand-edited migration files.

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ═══════════════════════════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════════════════════════

enum Role {
  BUYER
  AGENT
  ADMIN
}

enum ProductUnit {
  KG
  GRAM
  LITRE
  ML
  PACK
  PIECE
  BOX
}

enum PaymentMethod {
  WALLET
  UPI
  CARD
  COD
}

enum PaymentStatus {
  NOT_APPLICABLE
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum WalletTxnType {
  CREDIT
  DEBIT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum JobStatus {
  PENDING
  PROCESSED
  FAILED
}

// ═══════════════════════════════════════════════════════════════════════════
// Part 1 — Auth & Shop (B1-04)
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id                String   @id @default(uuid())
  phone             String   @unique
  email             String?  @unique
  role              Role
  firebaseUid       String?  @unique
  isActive          Boolean  @default(true)
  pushEnabled       Boolean  @default(true)
  orderUpdatesOptIn Boolean  @default(true)
  promoOptIn        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shopProfile   ShopProfile?
  agentProfile  AgentProfile?
  deviceTokens  DeviceToken[]
  refreshTokens RefreshToken[]
  orders        Order[]
  wallet        BuyerWallet?
  ratings       OrderRating[]
  tickets       SupportTicket[]
  referralCode  ReferralCode?
  referralsMade Referral[]      @relation("Referrer")
  referralsRecv Referral[]      @relation("Referred")
  auditLogs     AuditLog[]
  cartItems     CartItem[] // B2-06: server-side cart

  @@index([phone])
}

// Refresh-token rotation with family reuse-detection (B1-05). Opaque tokens are
// stored only as sha256 hashes; presenting an already-rotated token outside the
// grace window revokes the whole familyId. (Extends the base 22-model schema.)
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  familyId    String
  hashedToken String    @unique
  usedAt      DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model ShopProfile {
  id           String  @id @default(uuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id])
  shopName     String
  ownerName    String
  shopPhotoUrl String?
  addressLine  String
  city         String
  state        String
  pincode      String
  latitude     Float
  longitude    Float
  // Kept in sync with latitude/longitude on every write from the app layer.
  // GIST index added via raw SQL supplement in B3-02.
  location     Unsupported("geography(Point,4326)")?
  createdAt    DateTime                              @default(now())
  updatedAt    DateTime                              @updatedAt
}

model AgentProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  vehicleType   String?
  isAvailable   Boolean  @default(true)
  lastLatitude  Float?
  lastLongitude Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Email-OTP fallback storage (B1-06). OTPs are stored only as bcrypt hashes and
// pruned hourly by cron. (Extends the base 22-model schema — no OTP table exists there.)
model EmailOtp {
  id         String    @id @default(uuid())
  email      String
  otpHash    String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Part 2 — Catalog (B2-01). GIN trigram indexes on Product(name,brand) are added
// via the raw-SQL supplement migration (§2.2).
// ═══════════════════════════════════════════════════════════════════════════

model Category {
  id            String     @id @default(uuid())
  name          String
  slug          String     @unique
  iconUrl       String?
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  subcategories Category[] @relation("CategoryTree")
  displayOrder  Int        @default(0)
  isActive      Boolean    @default(true)
  products      Product[]
}

model Product {
  id           String            @id @default(uuid())
  name         String
  brand        String?
  sku          String            @unique
  categoryId   String
  category     Category          @relation(fields: [categoryId], references: [id])
  unit         ProductUnit
  unitSize     String
  caseQty      Int               @default(1)
  mrp          Decimal           @db.Decimal(10, 2)
  sellingPrice Decimal           @db.Decimal(10, 2)
  imageUrl     String?
  description  String?
  isActive     Boolean           @default(true)
  version      Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  inventory    ProductInventory?
  orderItems   OrderItem[]
  cartItems    CartItem[] // B2-06: server-side cart

  @@index([categoryId])
}

model ProductInventory {
  productId         String   @id
  product           Product  @relation(fields: [productId], references: [id])
  quantityAvailable Int      @default(0)
  quantityReserved  Int      @default(0)
  lowStockThreshold Int      @default(10)
  updatedAt         DateTime @updatedAt
}

// B2-06 — server-side cart (arch §3 Cart). @@unique([buyerId, productId]) makes
// add-item an upsert (re-adding a product increments quantity, no dup row) and its
// leftmost prefix (buyerId) doubles as the index for "load this buyer's cart".
model CartItem {
  id        String   @id @default(uuid())
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, productId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Part 3 — Orders & Payments (B3-01)
// ═══════════════════════════════════════════════════════════════════════════

model Order {
  id                 String        @id @default(uuid())
  buyerId            String
  buyer              User          @relation(fields: [buyerId], references: [id])
  agentId            String?
  status             OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(NOT_APPLICABLE)
  subtotalAmount     Decimal       @db.Decimal(10, 2)
  deliveryFee        Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount        Decimal       @db.Decimal(10, 2)
  deliveryAddress    Json // snapshot of ShopProfile address at order time
  version            Int           @default(1)
  placedAt           DateTime      @default(now())
  confirmedAt        DateTime?
  dispatchedAt       DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?

  items        OrderItem[]
  payment      Payment?
  rating       OrderRating?
  tracking     LiveTracking?
  locationLogs DeliveryLocationLog[]
  settlement   Settlement?

  @@index([buyerId])
  @@index([status])
  @@index([agentId])
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  productNameSnap String
  unitPriceSnap   Decimal @db.Decimal(10, 2)
  quantity        Int
  lineTotal       Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  razorpayOrderId   String?
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  capturedAt        DateTime?
  createdAt         DateTime      @default(now())
}

model BuyerWallet {
  buyerId      String              @id
  buyer        User                @relation(fields: [buyerId], references: [id])
  balance      Decimal             @default(0) @db.Decimal(10, 2)
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]
}

model WalletTransaction {
  id               String        @id @default(uuid())
  buyerId          String
  wallet           BuyerWallet   @relation(fields: [buyerId], references: [buyerId])
  type             WalletTxnType
  amount           Decimal       @db.Decimal(10, 2)
  balanceAfter     Decimal       @db.Decimal(10, 2)
  referenceOrderId String?
  createdAt        DateTime      @default(now())

  @@index([buyerId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Part 4 — Tracking & Ops (B3-02). GIST spatial index + AuditLog append-only
// enforcement are raw-SQL supplements (§2.2).
// ═══════════════════════════════════════════════════════════════════════════

// Single row per order — cheap O(1) reads for the 15s polling endpoint.
model LiveTracking {
  orderId   String                                @id
  order     Order                                 @relation(fields: [orderId], references: [id])
  agentId   String
  latitude  Float
  longitude Float
  location  Unsupported("geography(Point,4326)")?
  updatedAt DateTime                              @updatedAt
}

// Append-only history, pruned by cron every 30 days — used for audit/replay.
model DeliveryLocationLog {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  agentId    String
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  @@index([orderId])
}

model Settlement {
  id        String    @id @default(uuid())
  orderId   String    @unique
  order     Order     @relation(fields: [orderId], references: [id])
  agentId   String
  amount    Decimal   @db.Decimal(10, 2)
  status    String    @default("PENDING") // PENDING | PAID
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([agentId])
}

model OrderRating {
  orderId   String   @id
  order     Order    @relation(fields: [orderId], references: [id])
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model SupportTicket {
  id         String       @id @default(uuid())
  buyerId    String
  buyer      User         @relation(fields: [buyerId], references: [id])
  subject    String
  message    String
  status     TicketStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@index([buyerId])
}

model ReferralCode {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id])
  code      String   @unique
  createdAt DateTime @default(now())
}

model Referral {
  id             String   @id @default(uuid())
  referrerId     String
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id])
  referredId     String   @unique
  referred       User     @relation("Referred", fields: [referredId], references: [id])
  rewardCredited Boolean  @default(false)
  createdAt      DateTime @default(now())
}

// Restart-safety for in-memory node-cron: anything that must survive a server
// restart is written here BEFORE the triggering action, and replayed on boot (§4.5).
model JobRecovery {
  id          String    @id @default(uuid())
  jobType     String
  referenceId String
  status      JobStatus @default(PENDING)
  payload     Json
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
