# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_VERSION=1.0.0
LOG_LEVEL=info

# ── Database (Neon pooled connection string in prod; local docker in dev) ───
DATABASE_URL=postgresql://storefiller:storefiller@localhost:5433/storefiller?schema=public

# ── JWT (RS256). Generate: see scripts/gen-jwt-keys.sh. NEVER commit the private key. ──
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=storefiller

# ── Firebase Admin (stringified service-account JSON) ───────────────────────
FIREBASE_SERVICE_ACCOUNT=

# ── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SHOP_FOLDER=shop_photos
CLOUDINARY_PRODUCT_FOLDER=products
CLOUDINARY_DELIVERY_FOLDER=delivery_photos

# ── Razorpay (test-mode keys) ───────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend (email OTP fallback) ─────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Storefiller <onboarding@storefiller.in>

# ── Misc ─────────────────────────────────────────────────────────────────────
REFERRAL_REWARD_AMOUNT=100
CRON_TZ=Asia/Kolkata

# ── Mobile control plane (GET /api/v1/app-config) ────────────────────────────
# Version floor: builds below it get a blocking "update required" screen. Raise
# this to retire a broken release without waiting for a store review.
MIN_APP_VERSION_IOS=1.0.0
MIN_APP_VERSION_ANDROID=1.0.0
LATEST_APP_VERSION_IOS=1.0.0
LATEST_APP_VERSION_ANDROID=1.0.0
IOS_STORE_URL=https://apps.apple.com/app/storefiller/id000000000
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=in.storefiller.app
# true → every client shows a maintenance screen.
MAINTENANCE_MODE=false
# Comma-separated feature kill switches, e.g. wallet_topup,referral
DISABLED_FEATURES=
